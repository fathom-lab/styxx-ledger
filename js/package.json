{
  "name": "styxx-ledger",
  "version": "1.0.0-alpha.3",
  "description": "reference writer and verifier for the styxx ledger protocol v1 (javascript): an agent's append-only, hash-chained json-lines event log with daily posted heads, re-derivable by anyone holding the file",
  "type": "commonjs",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./verify": "./lib/verify.js",
    "./ledger": "./lib/ledger.js",
    "./v0": "./lib/v0.js",
    "./ots": "./lib/ots.js",
    "./exhibit": "./lib/exhibit.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "styxx-ledger": "bin/styxx-ledger.cjs"
  },
  "files": [
    "lib/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "vectors": "node ../vectors/run_vectors.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ledger",
    "hash-chain",
    "append-only",
    "tamper-evident",
    "audit-log",
    "jsonl",
    "agent",
    "opentimestamps",
    "jcs"
  ],
  "homepage": "https://github.com/fathom-lab/styxx-ledger/tree/main/js#readme",
  "bugs": {
    "url": "https://github.com/fathom-lab/styxx-ledger/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fathom-lab/styxx-ledger.git",
    "directory": "js"
  },
  "author": "Fathom Intelligence",
  "license": "MIT",
  "dependencies": {}
}
